#!/bin/sh
# akatsuki-reactivite — Réglages processeur / GPU / carte SD du Xperia XZ3, appliqués
# au démarrage selon le profil choisi (/etc/akatsuki/reactivite).
#
#   akatsuki-reactivite            applique le profil enregistré (défaut : frais)
#   akatsuki-reactivite frais      enregistre et applique « frais »
#   akatsuki-reactivite reactif    enregistre et applique « réactif »
#
# frais (13/10/2026, le téléphone chauffait) :
#   CPU : gouverneur ondemand, fréquences minimales d'origine, grands cœurs plafonnés
#         vers 2 GHz (au lieu de 2,8) ;
#   GPU : fréquence minimale la plus basse, maximale plafonnée vers 520 MHz (au lieu
#         de 710) : l'interface reste fluide, les pointes de chauffe disparaissent.
# reactif (12/10/2026 : le téléphone était lent à réagir) :
#   CPU : schedutil réactif (rate_limit_us 500), petits cœurs ≥ ~1 GHz, sans plafond ;
#   GPU : minimum relevé d'un cran, sans plafond.
# Les deux : carte SD en BFQ (priorité aux applications), lecture anticipée 1 Mio.
# Désactiver tout : systemctl disable --now akatsuki-reactivite ; reboot
set -u
conf=/etc/akatsuki/reactivite
case "${1:-}" in
	frais|reactif) install -d /etc/akatsuki; echo "$1" > "$conf" ;;
	"") ;;
	*) echo "usage : $0 [frais|reactif]" >&2; exit 2 ;;
esac
profil=$(cat "$conf" 2>/dev/null || echo frais)

ecrit() { [ -w "$1" ] && echo "$2" > "$1" 2>/dev/null; }
# freq <fichier de fréquences> <rang> : rang 1 = la plus basse, « max » = la plus haute,
# « <=N » = la plus haute ne dépassant pas N
freq() {
	tr ' ' '\n' < "$1" | grep . | sort -n | case "$2" in
		max) tail -n 1 ;;
		"<="*) awk -v n="${2#<=}" '$1 <= n { f = $1 } END { print f }' ;;
		*) sed -n "$2p" ;;
	esac
}

for p in /sys/devices/system/cpu/cpufreq/policy*; do
	fr="$p/scaling_available_frequencies"
	[ -r "$fr" ] || continue
	ecrit "$p/scaling_max_freq" "$(freq "$fr" max)"
	ecrit "$p/scaling_min_freq" "$(freq "$fr" 1)"
	if [ "$profil" = frais ]; then
		ecrit "$p/scaling_governor" ondemand
		# grands cœurs (policy4) : ~2 GHz au plus
		[ "${p##*policy}" -ge 4 ] && ecrit "$p/scaling_max_freq" "$(freq "$fr" '<=2000000')"
	else
		ecrit "$p/scaling_governor" schedutil
		ecrit "$p/schedutil/rate_limit_us" 500
		[ "${p##*policy}" = 0 ] && \
			ecrit "$p/scaling_min_freq" "$(tr ' ' '\n' < "$fr" | sort -n | awk '$1 >= 1000000 {print; exit}')"
	fi
done

for g in /sys/class/devfreq/*.gpu; do
	fr="$g/available_frequencies"
	[ -r "$fr" ] || continue
	ecrit "$g/governor" simple_ondemand
	# ordre : d'abord le minimum au plus bas, puis le maximum, puis le minimum voulu
	ecrit "$g/min_freq" "$(freq "$fr" 1)"
	if [ "$profil" = frais ]; then
		ecrit "$g/max_freq" "$(freq "$fr" '<=520000000')"
	else
		ecrit "$g/max_freq" "$(freq "$fr" max)"
		ecrit "$g/min_freq" "$(freq "$fr" 2)"
	fi
done

for q in /sys/block/mmcblk*/queue; do
	ecrit "$q/scheduler" bfq
	ecrit "$q/read_ahead_kb" 1024
done

c=/sys/devices/system/cpu/cpufreq
echo "profil $profil ; CPU : $(cat $c/policy0/scaling_governor 2>/dev/null)," \
	"petits $(cat $c/policy0/scaling_min_freq 2>/dev/null)-$(cat $c/policy0/scaling_max_freq 2>/dev/null)," \
	"grands max $(cat $c/policy4/scaling_max_freq 2>/dev/null) ;" \
	"GPU : $(cat /sys/class/devfreq/*.gpu/min_freq 2>/dev/null)-$(cat /sys/class/devfreq/*.gpu/max_freq 2>/dev/null)"
