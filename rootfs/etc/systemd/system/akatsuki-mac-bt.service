# Adresse Bluetooth d'origine (lue dans la TA), donnée au contrôleur à chaque démarrage.
[Unit]
Description=Adresse Bluetooth d'origine du Xperia XZ3
After=bluetooth.service
Wants=bluetooth.service
ConditionPathExists=/var/lib/miscta/ta.img

[Service]
Type=oneshot
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do [ -e /sys/class/bluetooth/hci0 ] && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/local/bin/akatsuki-mac bt

[Install]
WantedBy=multi-user.target
