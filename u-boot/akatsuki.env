# Environnement U-Boot du Xperia XZ3 (akatsuki) — sans UFS, sans fastboot.
bootdelay=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# Démarrage : extlinux.conf sur la carte micro-SD (/boot/extlinux/extlinux.conf)
bootcmd=bootflow scan -lb; pause; run menucmd
menucmd=setenv bootcmd run menucmd; bootmenu -1
bootmenu_0=Démarrer (carte SD)=bootflow scan -lb; pause
bootmenu_1=Lister les démarrages trouvés=bootflow scan -l; pause
bootmenu_2=Console U-Boot=setenv bootcmd; echo Console
bootmenu_3=Redémarrer=reset


# Volume bas maintenu au démarrage : menu
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
