# Fragment U-Boot pour le Xperia XZ3 (akatsuki), à appliquer après qcom_defconfig.
#
# SÉCURITÉ : sur Tama, toucher à l'UFS peut effacer le bootloader (brick). U-Boot n'a
# donc AUCUN pilote UFS / SCSI ici (le DTB les désactive aussi, garde-fou vérifié par
# scripts/check-dtb-ufs.sh), ni fastboot ni écriture de stockage depuis U-Boot.
CONFIG_DEFAULT_DEVICE_TREE="qcom/sdm845-sony-xperia-tama-akatsuki"
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/akatsuki.env"
# CONFIG_UFS is not set
# CONFIG_UFS_QCOM is not set
# CONFIG_PHY_QCOM_QMP_UFS is not set
# CONFIG_SCSI is not set
# CONFIG_CMD_UFS is not set
# CONFIG_CMD_SCSI is not set
# CONFIG_DFU_SCSI is not set
# CONFIG_USB_FUNCTION_FASTBOOT is not set
# CONFIG_FASTBOOT is not set
# CONFIG_CMD_FASTBOOT is not set
# CONFIG_EFI_CAPSULE_ON_DISK is not set
# CONFIG_EFI_RUNTIME_UPDATE_CAPSULE is not set
# Lire les messages sur l'écran en cas d'erreur
CONFIG_PANIC_HANG=y
CONFIG_CMD_PAUSE=y
CONFIG_BUTTON_REMAP_PHONE_KEYS=y
# Pas de port série sur le téléphone
# CONFIG_REQUIRE_SERIAL_CONSOLE is not set
# outils hôte inutiles (gnutls)
# CONFIG_TOOLS_MKEFICAPSULE is not set
