				vdd-s3-supply = <0xec>;
				vdd-s4-supply = <0xec>;
				smps3 {
					regulator-min-microvolt = <0x927c0>;
					regulator-max-microvolt = <0x927c0>;
				};
			};
		};
		interrupt-controller@17a00000 {
			compatible = "arm,gic-v3";
			#address-cells = <0x2>;
			#size-cells = <0x2>;
			ranges;
			#interrupt-cells = <0x3>;
			interrupt-controller;
			reg = <0x0 0x17a00000 0x0 0x10000 0x0 0x17a60000 0x0 0x100000>;
			interrupts = <0x1 0x9 0x4>;
			phandle = <0x1>;
			msi-controller@17a40000 {
				compatible = "arm,gic-v3-its";
				msi-controller;
				#msi-cells = <0x1>;
				reg = <0x0 0x17a40000 0x0 0x20000>;
				status = "disabled";
			};
		};
		dma-controller@17184000 {
			compatible = "qcom,bam-v1.7.4", "qcom,bam-v1.7.0";
			qcom,controlled-remotely;
			reg = <0x0 0x17184000 0x0 0x2a000>;
			num-channels = <0x17>;
			interrupts = <0x0 0xa4 0x4>;
			#dma-cells = <0x1>;
			qcom,ee = <0x1>;
			qcom,num-ees = <0x4>;
			iommus = <0x31 0x1806 0x0>;
			phandle = <0xb2>;
		};
		timer@17c90000 {
			#address-cells = <0x1>;
			#size-cells = <0x1>;
			ranges = <0x0 0x0 0x0 0x20000000>;
			compatible = "arm,armv7-timer-mem";
			reg = <0x0 0x17c90000 0x0 0x1000>;
			frame@17ca0000 {
				frame-number = <0x0>;
				interrupts = <0x0 0x7 0x4 0x0 0x6 0x4>;
				reg = <0x17ca0000 0x1000 0x17cb0000 0x1000>;
			};
			frame@17cc0000 {
				frame-number = <0x1>;
				interrupts = <0x0 0x8 0x4>;
				reg = <0x17cc0000 0x1000>;
				status = "disabled";
			};
			frame@17cd0000 {
				frame-number = <0x2>;
				interrupts = <0x0 0x9 0x4>;
				reg = <0x17cd0000 0x1000>;
				status = "disabled";
			};
			frame@17ce0000 {
				frame-number = <0x3>;
				interrupts = <0x0 0xa 0x4>;
				reg = <0x17ce0000 0x1000>;
				status = "disabled";
			};
			frame@17cf0000 {
				frame-number = <0x4>;
				interrupts = <0x0 0xb 0x4>;
				reg = <0x17cf0000 0x1000>;
				status = "disabled";
			};
			frame@17d00000 {
				frame-number = <0x5>;
				interrupts = <0x0 0xc 0x4>;
				reg = <0x17d00000 0x1000>;
				status = "disabled";
			};
			frame@17d10000 {
				frame-number = <0x6>;
				interrupts = <0x0 0xd 0x4>;
				reg = <0x17d10000 0x1000>;
				status = "disabled";
			};
		};
		interconnect@17d41000 {
			compatible = "qcom,sdm845-osm-l3", "qcom,osm-l3";
			reg = <0x0 0x17d41000 0x0 0x1400>;
			clocks = <0x2c 0x0 0x39 0xa5>;
			clock-names = "xo", "alternate";
			#interconnect-cells = <0x1>;
			phandle = <0x6>;
		};
		cpufreq@17d43000 {
			compatible = "qcom,sdm845-cpufreq-hw", "qcom,cpufreq-hw";
			reg = <0x0 0x17d43000 0x0 0x1400 0x0 0x17d45800 0x0 0x1400>;
			reg-names = "freq-domain0", "freq-domain1";
			interrupts-extended = <0xf0 0x0 0xf1 0x0>;
			clocks = <0x2c 0x0 0x39 0xa5>;
			clock-names = "xo", "alternate";
			#freq-domain-cells = <0x1>;
			#clock-cells = <0x1>;
			phandle = <0x2>;
		};
		wifi@18800000 {
			compatible = "qcom,wcn3990-wifi";
			status = "disabled";
			reg = <0x0 0x18800000 0x0 0x800000>;
			reg-names = "membase";
			memory-region = <0xf2>;
			clock-names = "cxo_ref_clk_pin";
			clocks = <0x2c 0x8>;
			interrupts = <0x0 0x19e 0x4 0x0 0x19f 0x4 0x0 0x1a0 0x4 0x0 0x1a1 0x4 0x0 0x1a2 0x4 0x0 0x1a3 0x4 0x0 0x1a4 0x4 0x0 0x1a5 0x4 0x0 0x1a6 0x4 0x0 0x1a7 0x4 0x0 0x1a8 0x4 0x0 0x1a9 0x4>;
			iommus = <0x31 0x40 0x1>;
		};
	};
