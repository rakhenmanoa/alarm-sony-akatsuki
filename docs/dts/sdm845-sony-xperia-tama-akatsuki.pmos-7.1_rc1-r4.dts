	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x1 0x1 0x8 0x1 0x2 0x8 0x1 0x3 0x8 0x1 0x0 0x8>;
	};
	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0xf9 0xfa 0xfb 0xfc>;
		pinctrl-names = "default";
		key-camera-focus {
			label = "Camera Focus";
			gpios = <0xe7 0x2 0x1>;
			linux,code = <0x210>;
			debounce-interval = <0xf>;
			linux,can-disable;
			wakeup-source;
		};
		key-camera-snapshot {
			label = "Camera Snapshot";
			gpios = <0xe7 0x7 0x1>;
			linux,code = <0xd4>;
			debounce-interval = <0xf>;
			linux,can-disable;
			wakeup-source;
		};
		key-volume-down {
			label = "Volume Down";
			gpios = <0xe7 0x5 0x1>;
			linux,code = <0x72>;
			debounce-interval = <0xf>;
			linux,can-disable;
			wakeup-source;
		};
		key-volume-up {
			label = "Volume Up";
			gpios = <0xe7 0x6 0x1>;
			linux,code = <0x73>;
			debounce-interval = <0xf>;
			linux,can-disable;
			wakeup-source;
		};
	};
	cam-vana-front-regulator {
		compatible = "regulator-fixed";
		regulator-name = "cam_vana_front_vreg";
		gpio = <0x7f 0x8 0x0>;
		enable-active-high;
		pinctrl-0 = <0xfd>;
		pinctrl-names = "default";
	};
	cam-vana-rear-regulator {
		compatible = "regulator-fixed";
		regulator-name = "cam_vana_rear_vreg";
		gpio = <0x7f 0x1b 0x0>;
		enable-active-high;
		pinctrl-0 = <0xfe>;
		pinctrl-names = "default";
	};
	cam-vio-reagulator {
		compatible = "regulator-fixed";
		regulator-name = "cam_vio_vreg";
		gpio = <0xe9 0xc 0x0>;
		enable-active-high;
		pinctrl-0 = <0xff>;
		pinctrl-names = "default";
	};
	vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <0x387520>;
		regulator-max-microvolt = <0x387520>;
		phandle = <0xec>;
	};
	pm8998-smps4 {
		compatible = "regulator-fixed";
		regulator-name = "vreg_s4a_1p8";
		regulator-min-microvolt = <0x1b7740>;
		regulator-max-microvolt = <0x1b7740>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <0xec>;
		phandle = <0xef>;
	};
	ts-vddio-regulator {
		compatible = "regulator-fixed";
		regulator-name = "ts_vddio";
		regulator-min-microvolt = <0x1c1380>;
		regulator-max-microvolt = <0x1c1380>;
		gpio = <0x7f 0x85 0x0>;
		enable-active-high;
		regulator-boot-on;
	};
};
